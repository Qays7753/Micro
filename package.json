{
  "name": "micro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Domain core for Micro, a SaaS financial and operational tool for home and microbusinesses.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "text-density": "python3 scripts/text-density-count.py",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prototype:dev": "pnpm --filter @micro/prototype-web dev",
    "prototype:check": "pnpm --filter @micro/prototype-web check",
    "prototype:test": "pnpm --filter @micro/prototype-web test",
    "prototype:build": "pnpm --filter @micro/prototype-web build",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "lint": "eslint src tests apps/prototype-web/client/src/pages apps/prototype-web/client/src/components --max-warnings 37",
    "check": "pnpm typecheck && pnpm lint && pnpm text-density && pnpm test && pnpm prototype:check && pnpm prototype:test && pnpm prototype:build"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
