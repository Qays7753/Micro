{
  "name": "micro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Domain core for Micro, a SaaS financial and operational tool for home and microbusinesses.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prototype:dev": "pnpm --filter @micro/prototype-web dev",
    "prototype:check": "pnpm --filter @micro/prototype-web check",
    "prototype:test": "pnpm --filter @micro/prototype-web test",
    "prototype:build": "pnpm --filter @micro/prototype-web build",
    "check": "pnpm typecheck && pnpm test && pnpm prototype:check && pnpm prototype:test && pnpm prototype:build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
