{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Micro control item",
  "type": "object",
  "required": ["id", "title", "type", "status", "priority", "stage", "summary", "acceptance", "areas", "contracts", "evidence", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "type": {"enum": ["GOVERNANCE", "DEFECT", "FEATURE", "QUALITY", "RESEARCH", "DECISION", "RELEASE"]},
    "status": {"enum": ["BACKLOG", "READY", "CLAIMED", "IN_PROGRESS", "IN_REVIEW", "MERGED_UNVERIFIED", "VERIFIED", "BLOCKED", "REVIEW_REQUIRED", "DEFERRED", "SUPERSEDED", "REOPENED"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "stage": {"type": "string"},
    "summary": {"type": "string"},
    "finding_classification": {"enum": ["NEW_FINDING", "DEEPENS_EXISTING", "DUPLICATE", "REOPENED", "FALSE_POSITIVE", "NOT_APPLICABLE"]},
    "finding_state": {"enum": ["UNVERIFIED", "CONFIRMED", "PARTIAL", "NOT_APPLICABLE"]},
    "root_cause": {"type": "string"},
    "source": {"type": "object"},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "areas": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "related_items": {"type": "array", "items": {"type": "string"}},
    "owner_decision": {"type": "string"},
    "merge_sha": {"type": "string"},
    "verified_on_main_sha": {"type": "string"},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  },
  "additionalProperties": false
}
