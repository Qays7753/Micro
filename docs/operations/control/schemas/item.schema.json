{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Micro control item",
  "type": "object",
  "required": ["id", "title", "type", "status", "priority", "stage", "summary", "source", "acceptance", "areas", "contracts", "evidence", "dependencies", "related_items", "updated_at", "status_history", "migration_baseline", "next_action"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 3},
    "type": {"type": "string", "enum": ["GOVERNANCE", "DEFECT", "FEATURE", "QUALITY", "RESEARCH", "DECISION", "RELEASE"]},
    "status": {"type": "string", "enum": ["BACKLOG", "READY", "CLAIMED", "IN_PROGRESS", "IN_REVIEW", "MERGED_UNVERIFIED", "VERIFIED", "BLOCKED", "REVIEW_REQUIRED", "DEFERRED", "SUPERSEDED", "REOPENED"]},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"]},
    "stage": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "finding_classification": {"type": "string", "enum": ["NEW_FINDING", "DEEPENS_EXISTING", "DUPLICATE", "REOPENED", "FALSE_POSITIVE", "NOT_APPLICABLE"]},
    "finding_state": {"type": "string", "enum": ["UNVERIFIED", "CONFIRMED", "PARTIAL", "NOT_APPLICABLE"]},
    "root_cause": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["report", "discovered_at_sha", "evidence"],
      "properties": {
        "report": {"type": "string", "minLength": 1},
        "discovered_at_sha": {"type": "string", "minLength": 7},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "areas": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contracts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}},
    "related_items": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"}},
    "owner_decision": {"type": "string"},
    "merge_sha": {"type": "string"},
    "verified_on_main_sha": {"type": "string"},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "changed_at", "actor", "reason"],
        "properties": {
          "status": {"type": "string", "enum": ["BACKLOG", "READY", "CLAIMED", "IN_PROGRESS", "IN_REVIEW", "MERGED_UNVERIFIED", "VERIFIED", "BLOCKED", "REVIEW_REQUIRED", "DEFERRED", "SUPERSEDED", "REOPENED"]},
          "changed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "actor": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "migration_baseline": {"type": "boolean"},
    "next_action": {"type": "string", "minLength": 1},
    "blocked_reason": {"type": "string", "minLength": 1},
    "deferred_reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
