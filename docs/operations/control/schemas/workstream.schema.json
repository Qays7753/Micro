{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Micro workstream claim",
  "type": "object",
  "required": ["id", "title", "status", "items", "branch", "base_sha", "areas", "contracts", "started_at", "updated_at", "next_action"],
  "properties": {
    "id": {"type": "string", "pattern": "^WS-[0-9]{3}$"},
    "title": {"type": "string"},
    "status": {"enum": ["CLAIMED", "IN_PROGRESS", "IN_REVIEW", "BLOCKED", "REVIEW_REQUIRED", "VERIFIED", "SUPERSEDED"]},
    "items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "branch": {"type": "string"},
    "base_sha": {"type": "string"},
    "areas": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "array", "items": {"type": "string"}},
    "agent": {"type": "string"},
    "pr": {"type": ["integer", "null"]},
    "started_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "next_action": {"type": "string"},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

