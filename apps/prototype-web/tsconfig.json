{
  "include": ["client/src/**/*", "worker/**/*"],
  /* EX-D18 (2026-11-12): worker/** = Cloudflare-compatible BFF source, typechecked here too. */
  /* NF-020 part 2 (2026-10-13): أُزيل استثناء ملفات الاختبار — كل ملفات
   * الاختبار داخل التدقيق النوعي الآن (226 ملفًا صارت مدققة؛ حراسة التغطية
   * في scripts/check-test-typecheck-coverage.mjs تمنع عودته). */
  "exclude": ["node_modules", "build", "dist"],
  "compilerOptions": {
    "target": "ES2022",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client", "vite-plugin-pwa/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@micro-domain/*": ["../../src/domain/*"]
    }
  }
}
