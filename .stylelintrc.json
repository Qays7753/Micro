{
  "rules": {
    "declaration-property-value-allowed-list": {
      "z-index": [
        "0",
        "1",
        "20",
        "30",
        "40",
        "50",
        "60",
        "70"
      ],
      "font-size": [
        "0.6875rem",
        "0.75rem",
        "0.8125rem",
        "0.875rem",
        "0.9375rem",
        "1rem",
        "1.0625rem",
        "1.125rem",
        "1.25rem",
        "1.5rem",
        "1.625rem",
        "1.75rem",
        "1.9375rem",
        "/^var\\(--/",
        "inherit"
      ]
    },
    "declaration-property-value-disallowed-list": {
      "z-index": [
        "auto",
        "/^9\\d+/"
      ]
    }
  },
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**"
  ]
}
