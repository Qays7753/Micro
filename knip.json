{
  "$schema": "https://unpkg.com/knip@6.48.0/schema.json",
  "rules": {
    "dependencies": "off",
    "devDependencies": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/domain/manage/index.ts",
        "src/domain/costing/index.ts",
        "src/domain/planning/index.ts"
      ],
      "project": [
        "src/domain/manage/**",
        "src/domain/costing/**",
        "src/domain/planning/**"
      ]
    },
    "apps/prototype-web": {
      "entry": [
        "client/src/application/manage/strings/index.ts",
        "client/src/application/planning/index.ts",
        "client/src/application/estimates/index.ts",
        "client/src/application/manage/api/index.ts",
        "client/src/application/manage/presentation/index.ts"
      ],
      "project": [
        "client/src/application/manage/**",
        "client/src/application/planning/**",
        "client/src/application/estimates/**"
      ],
      "paths": {
        "@/*": [
          "./client/src/*"
        ],
        "@micro-domain/*": [
          "../../src/domain/*"
        ],
        "virtual:pwa-register": [
          "./client/src/pwa/registerSW.virtual.ts"
        ]
      }
    }
  }
}
