 "makeRe": [
  {
   "case": {
    "pattern": "*.css",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$))(?=.)[^/]*?\\.css\\/?)$/"
   },
   "behavior": {
    "a.css": {
     "ok": true
    },
    "a/b.css": {
     "ok": false
    },
    "a.ts": {
     "ok": false
    },
    ".x.css": {
     "ok": true
    }
   }
  },
  {
   "case": {
    "pattern": "**/*.css",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$))(?:(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$)).)*?)\\/)?(?!\\.{1,2}(?:\\/|$))(?=.)[^/]*?\\.css\\/?)$/"
   },
   "behavior": {
    "a.css": {
     "ok": true
    },
    "a/b/c.css": {
     "ok": true
    },
    "a/b.css": {
     "ok": true
    }
   }
  },
  {
   "case": {
    "pattern": "a/**/b",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:a(?:\\/(?!\\.{1,2}(?:\\/|$))(?:(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$)).)*?)\\/|\\/|$)b)$/"
   },
   "behavior": {
    "a/b": {
     "ok": true
    },
    "a/x/b": {
     "ok": true
    },
    "a/x/y/b": {
     "ok": true
    },
    "x/b": {
     "ok": false
    }
   }
  },
  {
   "case": {
    "pattern": "x?.css",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:^(?:x[^/]\\.css)$)$/"
   },
   "behavior": {
    "xa.css": {
     "ok": true
    },
    "x.css": {
     "ok": false
    },
    "xab.css": {
     "ok": false
    }
   }
  },
  {
   "case": {
    "pattern": "[a-c].css",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:[a-c]\\.css)$/"
   },
   "behavior": {
    "a.css": {
     "ok": true
    },
    "d.css": {
     "ok": false
    }
   }
  },
  {
   "case": {
    "pattern": "{a,b}/*.css",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:(a|b)\\/(?!\\.{1,2}(?:\\/|$))(?=.)[^/]*?\\.css)$/"
   },
   "behavior": {
    "a/x.css": {
     "ok": true
    },
    "b/x.css": {
     "ok": true
    },
    "c/x.css": {
     "ok": false
    }
   }
  },
  {
   "case": {
    "pattern": "src/**/*.{css,CSS}",
    "options": {
     "dot": true
    }
   },
   "source": {
    "ok": "/^(?:src(?:\\/(?!\\.{1,2}(?:\\/|$))(?:(?:(?!(?:^|\\/)\\.{1,2}(?:\\/|$)).)*?)\\/|\\/|$)(?!\\.{1,2}(?:\\/|$))(?=.)[^/]*?\\.(css|CSS))$/"
   },
   "behavior": {
    "src/a.css": {
     "ok": true
    },
    "src/a.CSS": {
     "ok": true
    },
    "src/a.ts": {
     "ok": false
    }
   }
  }
 ],
