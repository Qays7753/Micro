modules = ["nodejs-20", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 8088
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @micro/prototype-web dev -- --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
